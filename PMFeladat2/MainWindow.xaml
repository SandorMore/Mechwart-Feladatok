<Window x:Class="PMFeladat2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PMFeladat2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"></ColumnDefinition>
            <ColumnDefinition Width="8*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
        </Grid.RowDefinitions>


        <ListBox>
            <Label x:Name="lb_fixed" Content="Adatbázis importálása"></Label>
            <Label x:Name="lb_connection_status" Content="Status: Not connected"></Label>
            <Button Content="Import" HorizontalAlignment="Center"></Button>
        </ListBox>

        <DataGrid Grid.Row="1" Grid.Column="1" x:Name="dg" AutoGenerateColumns="False" ItemsSource="{Binding}" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionChanged="dg_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding id}"></DataGridTextColumn>
                <DataGridTextColumn Header="Név" Binding="{Binding nev}" Width="150"></DataGridTextColumn>
                <DataGridTextColumn Header="Érték" Binding="{Binding ertek}" Width="150"></DataGridTextColumn>
                <DataGridTextColumn Header="Mióta veszéjeztetett" Binding="{Binding since}" Width="150"></DataGridTextColumn>
                <DataGridTextColumn Header="Fajta" Binding="{Binding fajta}" Width="170"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
