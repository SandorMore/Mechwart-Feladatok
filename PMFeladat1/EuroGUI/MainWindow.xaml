<Window x:Class="EuroGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EuroGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>


        <Button Background="LightGreen" Content="Csatlakozás" Grid.Row="0" Grid.Column="1" Click="Button_Click"/>
        <ListBox Grid.Column="1" Grid.Row="1">
            <Label x:Name="lb_conn_status" Content="Connection status:"/>
            <Label x:Name="lb_selected" Content="Szervező ország:"/>
            <Button x:Name="btn_szervezo" Content="Szervező megjelenítése" Click="btn_szervezo_Click"/>

            <Label x:Name="lb_mv" Content="Magyarországi versenyzők:"/>
            <Button x:Name="btn_mv" Content="Magyar Versenyzők" Click="btn_mv_Click"/>
        </ListBox>

        <DataGrid Grid.Column="0" Grid.Row="1" x:Name="dg" AutoGenerateColumns="False" ItemsSource="{Binding}" CanUserAddRows="False" SelectionMode="Single"
          SelectionUnit="FullRow" SelectionChanged="dg_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding id}" Width="50"/>
                <DataGridTextColumn Header="ev" Binding="{Binding ev}" Width="150"/>
                <DataGridTextColumn Header="eloado" Binding="{Binding eloado}" Width="100"/>
                <DataGridTextColumn Header="cim" Binding="{Binding cim}" Width="150"/>
                <DataGridTextColumn Header="helyezes" Binding="{Binding helyezes}" Width="100"/>
                <DataGridTextColumn Header="pontszam" Binding="{Binding pontszam}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
